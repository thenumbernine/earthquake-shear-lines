-- this is the odds of finding two things at random that match.
-- the equation is P(x) = 1 - n! / ((n - x)! n^x)
-- n = number of possible values
-- x = size of collection we are picking two things from.

local cache = {}
local function calcProbsForTwoQuakesInGeodesicForSampleSize(degreeThreshold)
	local n = math.round(360 / degreeThreshold)
	if cache[n] then return cache[n] end

--DEBUG:print('generating birthday problem for n='..n)
	local probs = {[0]=0}
	local denom = 1e+10
	local y = denom
	for x=1,n do
		y *= 1 - (x-1)/n
		local p = math.round(denom - y)
		if p == denom then break end
--DEBUG:print(' P('..x..') = '..p..'/'..denom)
		probs[x] = p/denom
	end
	cache[n] = probs

	return probs
end

return calcProbsForTwoQuakesInGeodesicForSampleSize
