local vec2d = require 'vec-ffi.vec2d'
local vec3d = require 'vec-ffi.vec3d'

local M = {}

-- don't know where else to put this, and this is becoming my misc file
M.dayInSec = 60 * 60 * 24

M.rotateX = |v,th|do
	local cs = vec2d.exp(th)
	return vec3d(
		v.x,
		v.y * cs.x - v.z * cs.y,
		v.y * cs.y + v.z * cs.x)
end

M.rotateY = |v,th|do
	local cs = vec2d.exp(th)
	return vec3d(
		v.x * cs.x + v.z * cs.y,
		v.x,
		-v.x * cs.y + v.z * cs.x)
end

M.rotateZ = |v,th|do
	local cs = vec2d.exp(th)
	return vec3d(
		v.x * cs.x - v.y * cs.y,
		v.x * cs.y + v.y * cs.x,
		v.z)
end

M.basisFor = |v| do
	local x = v:cross(vec3d(1, 0, 0))
	local y = v:cross(vec3d(0, 1, 0))
	local z = v:cross(vec3d(0, 0, 1))
	local xl = x:lenSq()
	local yl = y:lenSq()
	local zl = z:lenSq()
	-- TODO there's too many situations where ternary needs ()'s to save parsing... I should just change its symbols
	return xl > yl	-- x > y
		and (
			xl > zl
			and x	-- x > y, x > z
			or z		-- z > x > y
		)
		or (		-- y >= x
			yl > zl
			and y	-- y > z, y >= x
			or z	-- z > y >= x
		)
end

-- trying to fine-tune this one, wonder why I have to ...
-- is my julian date calculator off?
--[[
UTC time                    my julian day #  juliandate.org's julian-day-#  = timeanddate.com's (but they don't use hours etc / fractions)
2025-06-04 13:22:35.790 = 2460831.0573587   = 2460830.72361                 = 25155
... difference = 0.33350199973211
2025-05-04 00:00:14.865 = 2460799.500172    = 2460799.16667                 = 25124
... difference = 0.33374869963154
so my julian date is 8 hours ahead = my time zone, hmmmmmm is his timezone-offset? is mine?
--]]
M.julianBaseAngle = 47	-- why do I have this weird offset as the day base angle? and why do I keep updating it ...

-- Lua os.time calls mktime, which converts Y m d H M S to timestamp... with your timezone baked in.
-- where to put this ... here? charts? ... planets.rua?
-- This is duplicated in calcs.cl for the smallbodies
-- synodic day = normal day = 60*60*24 seconds = 86400 seconds
-- sidereal day = day relative to fixed distant points J2000 quazars or whatever
M.rotateFromSolarToEarthFrame = |v, jday| do
	-- https://en.wikipedia.org/wiki/Sidereal_time#Earth_rotation_angle
	-- McCarthy "Using UTC to Determine the Earth’s Rotation Angle" - http://hanksville.org/futureofutc/2011/preprints/13_AAS_11-666_McCarthy.pdf
	local julianUT1Date = jday - 2451545
	local earthRotationAngle = 2 * math.pi * (0.7790572732640 + 1.00273781191135448 * julianUT1Date)
	v = M.rotateZ(v, -earthRotationAngle)
	return v
end

-- this is quickly becoming the misc file
local Planets = require 'solarsystem.planets'
M.Planets = Planets
M.getPlanets = |julianDay| do
	--[[ use the full ephemeris from the solarsystem project (200 MB after the multiple GB download & conversion to binary)
	return Planets.fromEphemeris(julianDay, 406, '../solarsystem/eph/406')
	--]]
	-- [[ use a locally stored, truncated version of it, good for distributable.
	return Planets.fromEphemeris(julianDay, 406, 'eph406_1899-10-1_2200-04-06')
	--]]
end

--[[
planets' gravitational and tidal influences travel at speed 'c'
so they will take this many seconds to reach Earth:
	sun			507.15426258286
	mercury		330.8190124171
	venus		525.96477227756
	earth		0
	moon		1.2444409878557
	EM_Bary		0.015120686759085
	mars		1012.0507877836
	jupiter		3054.0160404048
	saturn		4559.6159352366
	uranus		10030.440841155
	neptune		14716.089717802
	pluto		17116.902571755
So for these calcs I really want the planet's position this many seconds in the past.

it only ever shifts by 1/10th of a day ... not going to make any difference raelly
--]]
M.getPlanetsDelayedInfluence = |julianDay| do
	local planets = M.getPlanets(julianDay)
	local delayedPlanets = Planets()
	for i,planet in ipairs(planets) do
		delayedPlanets[i].pos:set(planet.pos:unpack())
		delayedPlanets[i].vel:set(planet.vel:unpack())
	end
	local eph = require 'solarsystem.eph'
	assert(eph.hasInitialized())
	-- set to zero = disabled
	for iter=1,0 do	-- increase iterations to keep converging
		-- TODO pos / vel residual and stop when it gets small
		for i,planet in ipairs(delayedPlanets) do
			local delay_in_s = (planet.pos - planets[Planets.indexes.earth].pos):length() / 299792458
print('planet', planet.name, 'delay day', delay_in_s / M.dayInSec)
			local delayDay = julianDay - delay_in_s / M.dayInSec
			local posx, posy, posz, velx, vely, velz = eph[planet.name](delayDay)
			delayedPlanets[i].pos:set(posx * 1000, posy * 1000, posz * 1000)
			delayedPlanets[i].vel:set(velx * 1000, vely * 1000, velz * 1000)
		end
	end
	return delayedPlanets
end

return M
